{
  // PR previews only: the preview job in .github/workflows/checks.yml uploads
  // each PR's export as a version of this Worker. The live page stays on
  // GitHub Pages. The only deploy is the placeholder page the preview job
  // creates the Worker with.
  //
  // To rename, rename the Worker in the Cloudflare dashboard first: a preview
  // under a new name creates a new Worker, which then blocks the rename.
  "name": "io-notebook-preview",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist"
  },
  // Preview URLs need both.
  "preview_urls": true,
  "workers_dev": true
}
